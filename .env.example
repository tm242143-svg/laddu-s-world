VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Songs (no YouTube key needed). Optional: your own JioSaavn-compatible API for reliability.
# VITE_SAAVN_API=https://your-saavn-api.example.com/api

# Calls: STUN is built in. For phones on mobile data / strict Wi-Fi add a TURN relay (e.g. Metered, Cloudflare, coturn).
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# VITE_TURN_USER=
# VITE_TURN_PASS=
